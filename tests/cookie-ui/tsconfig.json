{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "react": [
        "node_modules/@types/react"
      ],
      "react/*": [
        "node_modules/@types/react/*"
      ],
      "posthog-js": [
        "node_modules/posthog-js"
      ]
    }
  },
  "include": [
    "*.ts",
    "*.tsx",
    "../../app/components/CookieBanner.tsx",
    "../../app/components/AnalyticsProvider.tsx"
  ]
}
